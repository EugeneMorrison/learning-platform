# Copy to .env (git-ignored) and adjust. Real environment variables win over .env.

# Production: leave DEBUG unset or False. Local development: DEBUG=True.
DEBUG=False

# Required when DEBUG is off: the server refuses to start without it. Also signs
# the JWT login tokens. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# With DEBUG=True and no SECRET_KEY, a dev key is kept in .dev-secret-key.
SECRET_KEY=

# Extra hosts, comma-separated. 186.246.9.251, localhost and 127.0.0.1 are
# always allowed (see backend/settings.py).
ALLOWED_HOSTS=

# Email (sign-up confirmation links). Required when DEBUG is off: the server
# refuses to start without EMAIL_HOST, DEFAULT_FROM_EMAIL and SITE_URL.
# With DEBUG=True and EMAIL_HOST empty, emails are printed to the console.
# Never commit real values: put them only in .env on the server.
EMAIL_HOST=
# 587 with EMAIL_USE_TLS=True, or 465 with EMAIL_USE_SSL=True (never both on).
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
# Sender address, e.g. Game Python <noreply@example.ru> (usually must match the SMTP account).
DEFAULT_FROM_EMAIL=
# Base of the links in emails, without a trailing slash, e.g. https://example.ru
SITE_URL=
