# Copy to .env (git-ignored) and adjust. Real environment variables win over .env.

# Production: leave DEBUG unset or False. Local development: DEBUG=True.
DEBUG=False

# Required when DEBUG is off: the server refuses to start without it. Also signs
# the JWT login tokens. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# With DEBUG=True and no SECRET_KEY, a dev key is kept in .dev-secret-key.
SECRET_KEY=

# Extra hosts, comma-separated. 186.246.9.251, localhost and 127.0.0.1 are
# always allowed (see backend/settings.py).
ALLOWED_HOSTS=

# Code runner (runner/, its own container). Required on the server: docker
# compose refuses to start without it and gives it to the web service and the
# runner (only this variable). At least 16 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RUNNER_TOKEN=

# Where Django sends student code. Docker sets it for the web service. Local
# development: empty runs code in-process (DEBUG=True only), or start
# `python runner/server.py` and set http://127.0.0.1:8001/run.
RUNNER_URL=

# Proxies in front of Django, for telling visitors apart by IP (rate limits).
# On the server (nginx in front): 1. Local runserver: 0 or empty.
DRF_NUM_PROXIES=

# Email. Never commit real values: put them only in .env on the server.
# Without EMAIL_HOST every email is printed to the console (local development).
# Check the setup with: python manage.py send_test_email you@example.ru
# Port 465 needs EMAIL_USE_SSL=True and EMAIL_USE_TLS=False;
# port 587 needs EMAIL_USE_TLS=True and EMAIL_USE_SSL=False.
# Keep comments on their own lines: never after a value.
# Example (Yandex):
#   EMAIL_HOST=smtp.yandex.ru
#   EMAIL_PORT=465
#   EMAIL_USE_SSL=True
#   EMAIL_USE_TLS=False
#   EMAIL_HOST_USER=noreply@uchebus.ru
#   EMAIL_HOST_PASSWORD=<app password from the Yandex account settings>
#   DEFAULT_FROM_EMAIL=УЧЁБУС <noreply@uchebus.ru>
#   SITE_URL=https://uchebus.ru
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Sender: the same address as EMAIL_HOST_USER (Yandex rejects any other).
DEFAULT_FROM_EMAIL=
# Base of the links in emails, without a trailing slash.
SITE_URL=
