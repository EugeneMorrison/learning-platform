# Copy to .env (git-ignored) and adjust. Real environment variables win over .env.

# Production: leave DEBUG unset or False. Local development: DEBUG=True.
DEBUG=False

# Required when DEBUG is off: the server refuses to start without it. Also signs
# the JWT login tokens. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# With DEBUG=True and no SECRET_KEY, a dev key is kept in .dev-secret-key.
SECRET_KEY=

# Extra hosts, comma-separated. 186.246.9.251, localhost and 127.0.0.1 are
# always allowed (see backend/settings.py).
ALLOWED_HOSTS=

# Code runner (runner/, its own container). Required on the server: docker
# compose refuses to start without it and gives it to the web service and the
# runner (only this variable). At least 16 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
RUNNER_TOKEN=

# Where Django sends student code. Docker sets it for the web service. Local
# development: empty runs code in-process (DEBUG=True only), or start
# `python runner/server.py` and set http://127.0.0.1:8001/run.
RUNNER_URL=
