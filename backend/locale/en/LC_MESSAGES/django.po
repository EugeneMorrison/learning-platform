msgid "Укажите course_id и other_user_id."
msgstr ""

#: .\api\views.py:1460
msgid "Обсуждение не найдено."
msgstr "Discussion not found."

#: .\api\views.py:1550
#, python-format
msgid "%(field)s: нужно true или false."
msgstr "%(field)s: must be true or false."

#: .\api\views.py:1553
msgid "Укажите is_resolved или is_pinned."
msgstr "Specify is_resolved or is_pinned."

#: .\api\views.py:1555
msgid "Закреплять обсуждения может только автор курса."
msgstr "Only the course author can pin discussions."

#: .\api\views.py:1557
msgid ""
"Отметить обсуждение решённым может только тот, кто его начал, или автор "
"курса."
msgstr ""
"Only whoever started the discussion or the course author can mark it "
"resolved."

#: .\api\views.py:1572
msgid "Удалять обсуждения может только автор курса."
msgstr "Only the course author can delete discussions."

#: .\api\views.py:1602
msgid "Сообщение не найдено."
msgstr "Message not found."

#: .\api\views.py:1620
msgid "Удалять сообщения может только автор курса."
msgstr "Only the course author can delete messages."

#: .\api\views.py:1643
msgid "Автор курса не отправляет жалобы: он может удалить сообщение."
msgstr "The course author does not report comments: they can delete them."

#: .\api\views.py:1645
msgid "Нельзя пожаловаться на своё сообщение."
msgstr "You cannot report your own message."

#: .\api\views.py:1647
msgid "Это сообщение автора курса: жалобы на него некому разбирать."
msgstr ""
"This is the course author's message: there is no one to review reports on it."

#: .\api\views.py:1649
msgid "Сообщение уже удалено."
msgstr "The message has already been deleted."

#: .\api\views.py:1668
msgid "Жалобы разбирает только автор курса."
msgstr "Only the course author handles reports."

#: .\api\views.py:1739
msgid "Укажите пользователя: user_id."
msgstr "Specify the user: user_id."

#: .\api\views.py:1741
msgid "Блокировать в обсуждениях может только автор курса."
msgstr "Only a course author can ban users from discussions."

#: .\api\views.py:1743
msgid "Нельзя заблокировать себя."
msgstr "You cannot ban yourself."

#: .\api\views.py:1745
msgid "Среди учащихся ваших курсов такого нет."
msgstr "No such student in your courses."

#: .\api\views.py:1760
